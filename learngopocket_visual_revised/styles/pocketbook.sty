\RequirePackage{listings}
\lstdefinelanguage{Go}{
  morekeywords={break,default,func,interface,select,case,defer,go,map,struct,chan,else,goto,package,switch,const,fallthrough,if,range,type,continue,for,import,return,var},
  morekeywords=[2]{bool,byte,complex64,complex128,error,float32,float64,int,int8,int16,int32,int64,rune,string,uint,uint8,uint16,uint32,uint64,uintptr,true,false,nil,iota},
  sensitive=true,
  morecomment=[l]{//},morecomment=[s]{/*}{*/},
  morestring=[b]",morestring=[b]'
}
\newcommand{\PocketGraySquare}{\tikz[baseline=-0.55ex]\fill[gray!48] (0,0) rectangle (1.35ex,1.35ex);}
\newcommand{\PocketYellowCircle}{\tikz[baseline=-0.55ex]\fill[PocketGold] (0.67ex,0.67ex) circle (0.67ex);}
\newcommand{\PocketGreenHeart}{{\PocketEmojiFont\color{PocketGreen}💚}}
\newcommand{\PocketBrokenHeart}{{\PocketEmojiFont\color{PocketRed}💔}}
\newcommand{\PocketParty}{{\PocketEmojiFont\color{PocketCoral}🎉}}
\newcommand{\PocketSad}{{\PocketEmojiFont\color{PocketGold!85!white}😔}}
\lstset{
  basicstyle=\ttfamily\small\color{PocketInk},
  keywordstyle=\bfseries\color{PocketTealDark},
  keywordstyle=[2]\color{PocketCoral!85!black},
  commentstyle=\itshape\color{PocketMuted},
  stringstyle=\color{PocketGreen!65!black},
  showstringspaces=false,keepspaces=true,columns=fullflexible,
  upquote=true,tabsize=4,breaklines=true,breakatwhitespace=false,
  postbreak=\mbox{\textcolor{PocketCoral}{\ensuremath{\hookrightarrow}}\space},
  literate=
    {\#1}{{\textcolor{PocketCoral}{\bfseries\#1}}}2
    {\#2}{{\textcolor{PocketCoral}{\bfseries\#2}}}2
    {\#3}{{\textcolor{PocketCoral}{\bfseries\#3}}}2
    {\#4}{{\textcolor{PocketCoral}{\bfseries\#4}}}2
    {\#5}{{\textcolor{PocketCoral}{\bfseries\#5}}}2
    {├}{{├}}1
    {└}{{└}}1
    {─}{{─}}1
    {│}{{│}}1,
  escapeinside={(*@}{@*)}
}

\RequirePackage[most]{tcolorbox}
\newtcblisting{gocode}[1][]{
  enhanced,breakable,listing only,
  colback=PocketCode,colframe=PocketCodeRule,
  boxrule=.45pt,arc=2mm,left=2.2mm,right=2.2mm,top=1.8mm,bottom=1.8mm,
  before skip=0.85\baselineskip,after skip=0.85\baselineskip,
  title style={color=PocketTealDark},
  colbacktitle=PocketTealDark,coltitle=white,
  fonttitle=\sffamily\bfseries\small,
  attach boxed title to top left={xshift=2mm,yshift=-1.2mm},
  boxed title style={boxrule=0pt,arc=1.5mm},
  listing options={language=Go},#1
}
\newtcblisting{shellcode}[1][]{
  enhanced,breakable,listing only,
  colback=PocketInk,colframe=PocketInk,coltext=white,
  boxrule=0pt,arc=2mm,left=2.2mm,right=2.2mm,top=1.8mm,bottom=1.8mm,
  before skip=0.85\baselineskip,after skip=0.85\baselineskip,
  colbacktitle=PocketCoral,coltitle=white,
  fonttitle=\sffamily\bfseries\small,
  attach boxed title to top left={xshift=2mm,yshift=-1.2mm},
  boxed title style={boxrule=0pt,arc=1.5mm},
  listing options={language={},basicstyle=\ttfamily\small\color{white},keywordstyle=\color{white},commentstyle=\color{white!70},stringstyle=\color{white}},#1
}
% Unicode box-drawing glyphs at the start of a listings line can be reordered by
% the verbatim scanner.  File trees therefore use ordinary XeTeX paragraphs in
% the same terminal treatment, which keeps every branch on its intended line.
\newtcolorbox{treebox}[1][]{
  enhanced,
  colback=PocketInk,colframe=PocketInk,coltext=white,
  boxrule=0pt,arc=2mm,left=3.2mm,right=3.2mm,top=2.2mm,bottom=2.2mm,
  before skip=0.85\baselineskip,after skip=0.85\baselineskip,
  fontupper=\ttfamily\small\color{white},
  before upper={\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}\setlength{\baselineskip}{1.15em}},#1
}
\newcommand{\PocketTreeLine}[1]{\noindent#1\par}
\newenvironment{codeannotations}{
  \begin{enumerate}[label=\textcolor{PocketCoral}{\#\arabic*},ref=\arabic*,leftmargin=2.7em,font=\sffamily\bfseries,itemsep=.15em,topsep=.25em]
}{\end{enumerate}}

\newtcolorbox{infobox}[1]{
  enhanced,breakable,title={#1},
  colback=PocketMist,colframe=PocketTeal,
  colbacktitle=PocketTeal,coltitle=white,
  fonttitle=\sffamily\bfseries,
  borderline west={1.4mm}{0pt}{PocketTeal},
  boxrule=0pt,arc=1.6mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
  before skip=1.0\baselineskip,after skip=1.0\baselineskip
}
\newtcolorbox{tipbox}[1]{
  enhanced,breakable,title={#1},
  colback=PocketPaper,colframe=PocketGold,
  colbacktitle=PocketGold,coltitle=PocketInk,
  fonttitle=\sffamily\bfseries,
  borderline west={1.4mm}{0pt}{PocketGold},
  boxrule=0pt,arc=1.6mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
  before skip=1.0\baselineskip,after skip=1.0\baselineskip
}
\newtcolorbox{warningbox}[1]{
  enhanced,breakable,title={#1},
  colback=PocketCoral!6,colframe=PocketCoral,
  colbacktitle=PocketCoral,coltitle=white,
  fonttitle=\sffamily\bfseries,
  borderline west={1.4mm}{0pt}{PocketCoral},
  boxrule=0pt,arc=1.6mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
  before skip=1.0\baselineskip,after skip=1.0\baselineskip
}

% Recreated status tiles used by the Gordle chapter.
\newcommand{\GordleTile}[2]{%
  \tikz[baseline=-0.6ex]{\node[minimum width=1.65em,minimum height=1.65em,inner sep=0pt,rounded corners=.35mm,fill=#1,text=white,font=\sffamily\bfseries\small]{#2};}%
}
\newcommand{\GordleAbsent}[1]{\GordleTile{gray!55}{#1}}
\newcommand{\GordleWrong}[1]{\GordleTile{PocketGold}{#1}}
\newcommand{\GordleCorrect}[1]{\GordleTile{PocketGreen}{#1}}

