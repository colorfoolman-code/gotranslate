\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/pocketbook}[2026/09/01 Chinese auxiliary-reader book design]

\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
% Review-environment compatibility: use installed system CJK families.
\setmainfont{Noto Serif CJK SC}[
  BoldFont={Noto Serif CJK SC Bold},
  ItalicFont={Noto Serif CJK SC},ItalicFeatures={FakeSlant=0.18},
  BoldItalicFont={Noto Serif CJK SC Bold},BoldItalicFeatures={FakeSlant=0.18}
]
\setsansfont{Noto Sans CJK SC}[
  BoldFont={Noto Sans CJK SC Bold},
  ItalicFont={Noto Sans CJK SC},ItalicFeatures={FakeSlant=0.18},
  BoldItalicFont={Noto Sans CJK SC Bold},BoldItalicFeatures={FakeSlant=0.18}
]
\setmonofont{Noto Sans Mono CJK SC}[
  BoldFont={Noto Sans Mono CJK SC Bold},
  ItalicFont={Noto Sans Mono CJK SC},ItalicFeatures={FakeSlant=0.12},
  BoldItalicFont={Noto Sans Mono CJK SC Bold},BoldItalicFeatures={FakeSlant=0.12},
  Scale=0.86
]
\newfontfamily\PocketEmojiFont{DejaVu Sans}
\newfontfamily\PocketDevanagariFont[Script=Devanagari]{Noto Sans Devanagari}
\newfontfamily\PocketArabicFont[Script=Arabic]{Noto Sans Arabic}
% Enable Chinese line-breaking before ucharclasses assigns the fallback-script
% classes; doing it afterwards would overwrite those assignments.
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip=0pt plus 0.8pt
\RequirePackage[Devanagari,Arabics]{ucharclasses}
\setTransitionsForDevanagari{\begingroup\PocketDevanagariFont}{\endgroup}
\setTransitionsForArabics{\begingroup\PocketArabicFont}{\endgroup}
% The source's ordinary Latin/CJK text remains in XeTeX class 0.  ucharclasses
% deliberately leaves class 0 alone, so add these class-0 edges explicitly.
\makeatletter
\newcommand{\PocketClassZeroTransition}[2]{%
  \XeTeXinterchartoks 0 #1={\begingroup#2}%
  \XeTeXinterchartoks #1 0={\endgroup}%
}
\PocketClassZeroTransition{\DevanagariDanDaClass}{\PocketDevanagariFont}
\PocketClassZeroTransition{\DevanagariPostDanDaClass}{\PocketDevanagariFont}
\PocketClassZeroTransition{\DevanagariPostMarksClass}{\PocketDevanagariFont}
\PocketClassZeroTransition{\DevanagariPreMarksClass}{\PocketDevanagariFont}
\PocketClassZeroTransition{\DevanagariExtendedAClass}{\PocketDevanagariFont}
\PocketClassZeroTransition{\ArabicClass}{\PocketArabicFont}
\PocketClassZeroTransition{\ArabicExtendedAClass}{\PocketArabicFont}
\PocketClassZeroTransition{\ArabicExtendedBClass}{\PocketArabicFont}
\PocketClassZeroTransition{\ArabicExtendedCClass}{\PocketArabicFont}
\PocketClassZeroTransition{\ArabicPresentationFormsAClass}{\PocketArabicFont}
\PocketClassZeroTransition{\ArabicPresentationFormsBClass}{\PocketArabicFont}
\PocketClassZeroTransition{\ArabicSupplementClass}{\PocketArabicFont}
\makeatother
\enableTransitionRules

