\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,positioning,shapes.geometric}
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\sffamily\bfseries\color{PocketInk}}
  {\begin{tikzpicture}[baseline]
     \fill[PocketTeal,rounded corners=2.2mm] (0,0) rectangle (22mm,10mm);
     \node[font=\sffamily\bfseries\color{white}] at (11mm,5mm) {第\thechapter 章};
     \draw[PocketCoral,line width=1.3pt] (25mm,5mm)--(\textwidth,5mm);
   \end{tikzpicture}}
  {1.1ex}
  {\Huge\raggedright}
\titlespacing*{\chapter}{0pt}{-9mm}{12mm}
\titleformat{\section}
  {\Large\sffamily\bfseries\color{PocketTealDark}}
  {\thesection}{0.8em}{}
\titlespacing*{\section}{0pt}{2.2\baselineskip}{0.55\baselineskip}
\titleformat{\subsection}
  {\large\sffamily\bfseries\color{PocketInk}}
  {\thesubsection}{0.75em}{}
\titlespacing*{\subsection}{0pt}{1.6\baselineskip}{0.35\baselineskip}
\titleformat{\subsubsection}
  {\normalsize\sffamily\bfseries\color{PocketTealDark}}
  {\thesubsubsection}{0.65em}{}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\sffamily\color{PocketMuted}\leftmark}
\fancyhead[RO]{\small\sffamily\color{PocketMuted}\rightmark}
\fancyfoot[LE,RO]{\sffamily\bfseries\color{PocketTealDark}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{第\thechapter 章\enspace #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace #1}}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\sffamily\bfseries\color{PocketTealDark}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

